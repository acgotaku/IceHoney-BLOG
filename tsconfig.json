{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vitepress/client", "node"],
    "lib": ["esnext", "dom", "dom.iterable"]
  },
  "include": [
    "src/.vitepress/**/*.ts",
    "src/.vitepress/**/*.mts",
    "src/.vitepress/**/*.vue",
    "src/**/*.paths.ts"
  ]
}
